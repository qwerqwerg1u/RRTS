    humanoidRootPart18.CFrame = CFrame.new(v116.Position)
    humanoidRootPart18.Position = v116.Position
    humanoidRootPart18.AssemblyLinearVelocity = Vector3.zero

    task.wait(0.8)
end
end
end

return
end


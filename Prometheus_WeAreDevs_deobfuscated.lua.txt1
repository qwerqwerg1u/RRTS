            partOwner = v118

            partOwner = v118
            or head3:FindFirstChild("PartOwner")
            and head3.PartOwner.Value == localPlayer11.Name
            or not v116.Enabled
        until partOwner

    if v116.Enabled and head3:FindFirstChild("PartOwner")

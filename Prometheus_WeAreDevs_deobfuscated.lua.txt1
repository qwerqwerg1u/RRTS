function updateLoopDropdown(p33)
    local v56 = {}

    for key7, value36 in pairs(v53) do
        table.insert(v56, key7)
    end

p33:Refresh(v56, true)
end

function disableCollisions(p34)
    for index9, value37 in ipairs(p34:GetDescendants()) do
        if value37:IsA("BasePart") then
            value37.CanCollide = false
        end
end
end

function flingPlayer(p35, p36)
    disableCollisions(p36.Parent)

    local instance = Instance.new("BodyVelocity", p35)
    instance.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    instance.Velocity = Vector3.new(0, 1000000000, 0)

    p36.Jump = true
    p36.Sit = false

    task.delay(3, function()
        if instance.Parent then
            instance:Destroy()
        end
end)
end

function isAboveThreshold(p37, p38)
    local humanoidRootPart9 = p37.Character and p37.Character:FindFirstChild("HumanoidRootPart")
    return not humanoidRootPart9 or humanoidRootPart9.Position.Y > p38
end

function savePivot(p39)
    if localPlayer6.Character and localPlayer6.Character:FindFirstChild("HumanoidRootPart") then
        p39.SavedPivot = localPlayer6.Character:GetPivot()
    end
end

function resetPivot(p40)
    local humanoidRootPart10 = localPlayer6.Character
    and localPlayer6.Character:FindFirstChild("HumanoidRootPart")

    if humanoidRootPart10
    and p40.SavedPivot
    and (humanoidRootPart10.Position - p40.SavedPivot.Position).Magnitude
    > p40.DistanceThreshold then
    localPlayer6.Character:PivotTo(p40.SavedPivot)
end
end

function actionOnPlayer(p41, p42)
    if not p42.Enabled then
        return
    end

if workspaceService:FindFirstChild("PlotItems")
and workspaceService.PlotItems.PlayersInPlots:FindFirstChild(p41.Name) then
return
end

local character10 = p41.Character

if not character10 then
    return
end

local humanoidRootPart11 = character10:FindFirstChild("HumanoidRootPart")
local humanoid6 = character10:FindFirstChildOfClass("Humanoid")
local head2 = character10:FindFirstChild("Head")
local character11

if humanoidRootPart11 and humanoid6 and head2 and humanoid6.Health > 0
and not isAboveThreshold(p41, p42.HeightThreshold) then
character11 = localPlayer6.Character

if not character11 then
    return
end

if not character11:FindFirstChild("HumanoidRootPart") then
    return
end

pcall(function()
    savePivot(p42)
    character11:PivotTo(CFrame.new(humanoidRootPart11.Position + p42.Offset))
    disableCollisions(character10)

    replicatedStorage.GrabEvents.SetNetworkOwner:FireServer(
    humanoidRootPart11, humanoidRootPart11.CFrame
    )

    task.wait()
    resetPivot(p42)
    task.wait(0.1)
    replicatedStorage.GrabEvents.DestroyGrabLine:FireServer(humanoidRootPart11)
    task.wait(0.1)

    if head2:FindFirstChild("PartOwner") and head2.PartOwner.Value == localPlayer6.Name then
        flingPlayer(humanoidRootPart11, humanoid6)
        task.wait(0.1)
        humanoid6.Health = 0
    end
end)

task.wait(p42.Delay)
return
end
end

function loopKill()
    for key8, value38 in pairs(v53) do
        local findFirstChild4 = players:FindFirstChild(key8)

        if findFirstChild4 then
            actionOnPlayer(findFirstChild4, v54)
        end
end
end

local connect4

function loopControl()
    connect4 = runService.Heartbeat:Connect(function()
        if v54.Enabled then
            loopKill()
        end
end)
end

function stopLoop()
    v54.Enabled = false

    if connect4 then
        connect4:Disconnect()
    end

v54.SavedPivot = nil
end


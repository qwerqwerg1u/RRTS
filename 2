             remainText = "Time Left: about " .. tostring(result.days_left) .. " days"
         elseif result.expires_at then
             remainText = "Expires at: " .. tostring(result.expires_at)
         end
         RemainLabelEN:Set(remainText)

         StatusLabelEN:Set("Success! Loading script...")
         
         Rayfield:Notify({
            Title = "Success",
            Content = SaveKeyEnabled and "Key saved. Next time it will auto-skip" or "Key was not saved",
            Duration = 4,
            Image = 4483362458,
         })

         getgenv().SCRIPT_KEY = key

         task.wait(1.3)
         Rayfield:Destroy()

         loadstring(game:HttpGet("https://api.jnkie.com/api/v1/luascripts/public/35f54c04a0637b69705ea1553cca053c13cddb87e97579b79de082981d7ac8ef/download"))()
      else
         failCount = failCount + 1
         local err = "Invalid key"
         if typeof(result) == "table" then
             err = result.error or result.message or "Invalid key"
         end
         StatusLabelEN:Set("Failed: " .. tostring(err) .. " (" .. failCount .. "/5)")
         RemainLabelEN:Set("Time Left: -")
         
         Rayfield:Notify({
            Title = "verify Failed",
            Content = tostring(err),
            Duration = 5,
            Image = 4483362458,
